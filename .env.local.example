# ============================================================================
# HanuONE — environment template.  Copy to .env.local and fill in.
# For a Vercel deploy, add each of these under Project → Settings → Env Vars.
# NEXT_PUBLIC_* are exposed to the browser; everything else is server-only.
# Anything marked (optional) can be left blank — the feature degrades safely.
# ============================================================================

# ── Database (Neon or Supabase Postgres) ────────────────────────────
# Drizzle + @neondatabase/serverless read this. REQUIRED.
DATABASE_URL=postgres://user:pass@host/db

# ── Auth (session signing) ──────────────────────────────────────────
# Generate: openssl rand -base64 32.  REQUIRED.
AUTH_SECRET=change_me_to_a_long_random_string
# Set to 1 in local dev to accept OTP code 000000; MUST be 0 in production.
OTP_TEST_MODE=0

# ── Dr Hanu AI triage (Azure AI Foundry — Claude Opus) ──────────────
# REQUIRED for /ai-doctor. Without these the AI triage endpoint fails.
HANUONE_AI_URL=https://your-foundry-endpoint/chat/completions
HANUONE_AI_KEY=your_foundry_api_key
HANUONE_AI_MODEL=claude-opus-4-8
# Realtime voice booking (optional — powers the voice assistant).
HANUONE_REALTIME_ENDPOINT=
HANUONE_REALTIME_KEY=
HANUONE_REALTIME_DEPLOYMENT=
HANUONE_REALTIME_APIVERSION=

# ── Razorpay (TEST keys now; swap for live after incorporation) ─────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_test_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx

# ── Supabase (public reads + Storage for docs/prescriptions/reports) ─
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_key

# ── Rate limiting (Upstash Redis — optional) ────────────────────────
# Without these, rate limiting falls back to an in-memory limiter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Email (Resend) ──────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM=Hanuone <onboarding@resend.dev>
NOTIFY_EMAIL=ops@hanuone.in

# ── SMS / OTP (MSG91) ───────────────────────────────────────────────
# Leave MSG91_AUTH_KEY empty in local dev with OTP_TEST_MODE=1.
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE=
MSG91_SENDER_ID=
MSG91_DLT_TEMPLATE=

# ── WhatsApp Cloud API (optional — patient notifications) ────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_WABA_ID=
WHATSAPP_VERIFY_TOKEN=

# ── Firebase (optional — web push + Google/Firebase sign-in) ────────
FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# ── Video (Jitsi) ───────────────────────────────────────────────────
NEXT_PUBLIC_JITSI_DOMAIN=meet.jit.si

# ── Error monitoring (Sentry — optional) ────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ── Cron jobs (Vercel Cron auth — optional) ─────────────────────────
# Protects scheduled endpoints; set the same value in Vercel Cron headers.
CRON_SECRET=

# ── Misc ────────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_maps_key
# Canonical site origin — used in emails, notifications and SEO/JSON-LD.
NEXT_PUBLIC_SITE_URL=https://hanuone.in
