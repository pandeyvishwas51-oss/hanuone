# ── Database (Supabase Postgres, Mumbai region) ─────────────────────
# Use the Supabase connection string (or Neon). Drizzle reads this.
DATABASE_URL=postgres://user:pass@host/db

# ── Supabase (public reads + Storage for docs/prescriptions/reports) ─
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_key

# ── Auth (session signing) ──────────────────────────────────────────
# Generate: openssl rand -base64 32
AUTH_SECRET=change_me_to_a_long_random_string

# ── MSG91 (OTP + SMS + WhatsApp) ────────────────────────────────────
# Leave MSG91_AUTH_KEY empty in local dev → OTP flow accepts code 000000.
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE=
MSG91_SENDER_ID=
MSG91_DLT_TEMPLATE=

# ── Razorpay (TEST keys now; swap for live after incorporation) ─────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_test_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx

# ── Video (Jitsi) ───────────────────────────────────────────────────
NEXT_PUBLIC_JITSI_DOMAIN=meet.jit.si

# ── Email (Resend) ──────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM=Hanuone <onboarding@resend.dev>
NOTIFY_EMAIL=ops@hanuone.in

# ── Misc ────────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_maps_key
NEXT_PUBLIC_SITE_URL=https://hanuone.in
